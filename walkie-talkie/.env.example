# ---- Walkie Talkie configuration ----
APP_NAME="PulseLink"
APP_ENV=local
APP_DEBUG=false

# Leave empty to auto-detect. Example for XAMPP: /walkie-talkie
APP_BASE_PATH=

# Optional: public URL shown in the QR code (e.g. https://walkie.example.com/)
APP_PUBLIC_URL=

# REQUIRED: long random string used to sign tokens (HMAC-SHA256).
# Generate one:  php -r "echo bin2hex(random_bytes(32));"
SIGNAL_SECRET=CHANGE_THIS_SECRET

# Max users per channel (2-8 recommended for mesh WebRTC)
SIGNAL_MAX_PEERS=8

# Max talk time per transmission (milliseconds)
SIGNAL_FLOOR_TIMEOUT_MS=30000

# Max size of one signaling request (bytes) and of one WebRTC data block (bytes)
SIGNAL_MAX_BODY=32768
SIGNAL_MAX_DATA=12288

# Token lifetime in seconds (tokens are renewed automatically while you stay connected)
SIGNAL_TOKEN_TTL=900

# A user without any request for this long is removed from the channel (ms)
SIGNAL_PEER_TIMEOUT_MS=15000

# Rate limit: max requests per peer per window (seconds)
SIGNAL_RATE_LIMIT=600
SIGNAL_RATE_WINDOW=60

# Optional TURN server (needed on strict networks / mobile data). Comma separated URLs.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
